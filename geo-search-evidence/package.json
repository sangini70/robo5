{
  "name": "geo-search-evidence-collector",
  "version": "0.1.0",
  "private": true,
  "description": "Search evidence collector for GEO workflows.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "planner": "node dist/input/collect-md.js",
    "collect:md": "npm run planner --",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('Project initialized.')\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
